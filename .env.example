# =============================================================================
# .env.example — Variables de docker-compose (copiar a .env; .env no se commitea)
# Autor: Jesús Montalvo <jmontalvo_m@outlook.com>
# =============================================================================

# UID/GID del usuario dueño de ./data y ./secrets (en el VPS: id -u / id -g de yisus)
DBSYNC_UID=1000
DBSYNC_GID=1000

# URL pública del gateway: va dentro de los enlaces que entrega el bot
GATEWAY_PUBLIC_BASE_URL=https://dumps.synkra.app

# Puerto local donde nginx hace proxy (127.0.0.1). En el VPS 18080 ya lo usa engram
GATEWAY_HOST_PORT=18090

# Tu ID de Telegram (varios separados por coma)
BOT_ALLOWED_USER_IDS=506679030

# Cuota y retención de dumps en disco (el VPS tiene ~17 GB libres)
GATEWAY_MAX_DUMPS_GB=8
GATEWAY_RETENTION_HOURS=24

# Enlaces: defaults del asistente
BOT_DEFAULT_TTL_SECONDS=3600
BOT_DEFAULT_MAX_DOWNLOADS=1

# Carpeta con los servers/*.env que ve el bot (ponla solo con los servidores que quieras exponer)
# DBSYNC_SERVERS_DIR=./servers
