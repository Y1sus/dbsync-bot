# =============================================================================
# servers/example.env — Plantilla de servidor para dbsync-bot (copiar y renombrar)
# El nombre del archivo (sin .env) es el identificador del servidor.
# Autor: Jesús Montalvo <jmontalvo_m@outlook.com>
# NUNCA commitear el archivo real: contiene credenciales. Usar chmod 600.
# =============================================================================

# Acceso SSH al servidor de producción
SERVER_HOST=192.168.1.100
SERVER_USER=deploy
SERVER_KEY=/run/secrets/dbsync_key
SERVER_PORT=22

# docker | native | native+sudo
DB_ACCESS_MODE=docker

# Credenciales de BD (usa un usuario de solo lectura con SELECT, LOCK TABLES,
# SHOW VIEW, TRIGGER, EVENT y PROCESS/RELOAD si tu dump los requiere)
DB_USER=readonly
DB_PASSWORD=cambiame

# Puertos opcionales dentro del contenedor o servicio (defaults: 3306 / 5432)
# DB_PORT=3306
