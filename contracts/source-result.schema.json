{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbsync-bot/contracts/source-result.schema.json",
  "$comment": "Contrato del servicio de GitLab (services/gitlab/fetch.py). Autor: Jesús Montalvo <jmontalvo_m@outlook.com>. Versión 1.",
  "title": "SourceResult",
  "description": "Salida JSON (una línea) de fetch.py por stdout; los logs van a stderr. Códigos de salida: 0 éxito, 1 fallo operativo, 2 uso incorrecto.",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "command"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "enum": [
        "catalog",
        "branches",
        "tags",
        "archive"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/refs"
    },
    {
      "$ref": "#/$defs/archive"
    }
  ],
  "$defs": {
    "error": {
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "E_USAGE",
                "E_CONFIG",
                "E_INVALID_NAME",
                "E_NOT_ALLOWED",
                "E_AUTH",
                "E_FORBIDDEN",
                "E_NOT_FOUND",
                "E_RATE_LIMITED",
                "E_GITLAB",
                "E_NETWORK",
                "E_TOO_LARGE",
                "E_TRUNCATED",
                "E_DISK",
                "E_INTERNAL"
              ],
              "description": "E_CONFIG incluye el rechazo de un token con permisos de escritura (alcance api, write_*, etc.)."
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "ok",
        "error"
      ]
    },
    "catalog": {
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "catalog"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "has_db"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "has_db": {
                "type": "boolean"
              },
              "db": {
                "type": "object",
                "required": [
                  "server",
                  "container",
                  "db"
                ],
                "properties": {
                  "server": {
                    "type": "string"
                  },
                  "container": {
                    "type": "string"
                  },
                  "db": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "ok",
        "projects"
      ]
    },
    "refs": {
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "enum": [
            "branches",
            "tags"
          ]
        },
        "project": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sha"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "default": {
                "type": "boolean"
              },
              "protected": {
                "type": "boolean"
              },
              "sha": {
                "type": "string"
              }
            }
          }
        },
        "truncated": {
          "type": "boolean",
          "description": "true si hay más de las que se devuelven (tope 300); usa --search."
        }
      },
      "required": [
        "ok",
        "project",
        "refs",
        "truncated"
      ]
    },
    "archive": {
      "properties": {
        "ok": {
          "const": true
        },
        "command": {
          "const": "archive"
        },
        "job_id": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Commit resuelto de la referencia antes de descargar; el archivo corresponde exactamente a este commit."
        },
        "format": {
          "enum": [
            "zip",
            "tar.gz"
          ]
        },
        "file": {
          "type": "string"
        },
        "relpath": {
          "type": "string",
          "description": "_gitlab/<archivo>; relativo a DBSYNC_DUMPS_DIR."
        },
        "filename": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "object",
          "required": [
            "archive"
          ],
          "properties": {
            "archive": {
              "const": true,
              "description": "El zip o tar.gz se abrió completo y tiene entradas."
            }
          }
        }
      },
      "required": [
        "ok",
        "job_id",
        "project",
        "ref",
        "commit",
        "format",
        "file",
        "relpath",
        "filename",
        "size_bytes",
        "sha256",
        "duration_s",
        "verified"
      ]
    }
  }
}
