{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbsync-bot/contracts/link.schema.json",
  "$comment": "Contrato bot <-> gateway (API interna v1). Autor: Jesús Montalvo <jmontalvo_m@outlook.com>. Un cambio incompatible incrementa la versión de la ruta (/v2) y se actualizan gateway y bot a la vez.",
  "title": "Gateway internal API",
  "$defs": {
    "iso_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "LinkCreateRequest": {
      "type": "object",
      "required": ["relpath", "created_by", "job_id"],
      "additionalProperties": false,
      "properties": {
        "relpath": { "type": "string", "description": "<servidor>/<archivo>.sql.gz relativo a la raíz de dumps; sin '..', sin '/' inicial." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lo entrega el runner; el gateway no recalcula (1 vCPU)." },
        "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 604800, "default": 3600 },
        "max_downloads": { "type": "integer", "minimum": 1, "maximum": 20, "default": 1 },
        "created_by": { "type": "string", "maxLength": 64 },
        "job_id": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 120 }
      }
    },
    "LinkRecord": {
      "type": "object",
      "required": ["id", "filename", "relpath", "size_bytes", "created_at", "expires_at", "max_downloads", "downloads_completed", "state", "created_by", "job_id", "download_in_progress"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{12}$", "description": "Identificador público para listar y revocar. NO es el token." },
        "filename": { "type": "string" },
        "relpath": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/iso_utc" },
        "expires_at": { "$ref": "#/$defs/iso_utc" },
        "max_downloads": { "type": "integer" },
        "downloads_completed": { "type": "integer" },
        "state": { "enum": ["active", "expired", "exhausted", "revoked"] },
        "created_by": { "type": "string" },
        "job_id": { "type": "string" },
        "label": { "type": ["string", "null"] },
        "download_in_progress": { "type": "boolean" }
      }
    },
    "LinkCreated": {
      "allOf": [ { "$ref": "#/$defs/LinkRecord" } ],
      "required": ["url"],
      "properties": { "url": { "type": "string", "description": "<PUBLIC_BASE_URL>/d/<token>. El token solo se devuelve aquí; el gateway guarda su hash." } }
    },
    "LinkList": {
      "type": "object",
      "required": ["links"],
      "properties": { "links": { "type": "array", "items": { "$ref": "#/$defs/LinkRecord" } } }
    },
    "Health": {
      "type": "object",
      "required": ["ok", "links_active", "disk_free_mb"],
      "properties": { "ok": { "const": true }, "links_active": { "type": "integer" }, "disk_free_mb": { "type": "integer" } }
    },
    "Error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["invalid_request", "unauthorized", "file_not_found", "not_found", "internal"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
